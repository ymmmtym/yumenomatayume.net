{
  "name": "basic",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "preview": "wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint app scripts",
    "upload": "bun run scripts/upload-and-replace.ts",
    "test:smoke": "bun run scripts/smoke-test.ts",
    "test:search": "bun run build && bun run scripts/test-search-body.ts && bun run scripts/test-search-dismissal.ts"
  },
  "private": true,
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "entities": "^9.0.0",
    "fuse.js": "^7.3.0",
    "hono": "^4.10.7",
    "honox": "^0.1.53",
    "mdast-util-from-markdown": "^2.0.2",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@hono/vite-build": "^1.3.0",
    "@hono/vite-dev-server": "^0.26.0",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "cloudinary": "^2.8.0",
    "oxlint": "^1.93.0",
    "prismjs": "^1.30.0",
    "rehype-prism-plus": "^2.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "tailwindcss": "^4.0.9",
    "ts-api-utils": "1.4.3",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "wrangler": "^4.4.0",
    "yaml": "^2.8.2"
  }
}
