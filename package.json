{
  "name": "basic",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "preview": "wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint app scripts",
    "test": "bun test",
    "upload": "bun run scripts/upload-and-replace.ts",
    "test:smoke": "bun run scripts/smoke-test.ts",
    "test:search": "bun run build && bun run scripts/test-search-body.ts && bun run scripts/test-search-dismissal.ts"
  },
  "private": true,
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "entities": "^9.0.0",
    "fuse.js": "^7.5.0",
    "hono": "^4.13.23",
    "honox": "^0.1.63",
    "mdast-util-from-markdown": "^2.1.0",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.11",
    "cloudinary": "^2.11.0",
    "oxlint": "^1.95.0",
    "prismjs": "^1.30.0",
    "rehype-prism-plus": "^2.0.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "ts-api-utils": "1.4.3",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "wrangler": "^4.169.0",
    "yaml": "^2.9.1"
  }
}
