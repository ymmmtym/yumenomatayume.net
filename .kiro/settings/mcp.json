{
  "mcpServers": {
    "linear": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ],
      "trustedTools": ["list_issues", "get_issue", "list_comments", "list_project_labels", "list_documents", "get_document", "get_issue_status", "list_projects", "get_user", "list_issue_statuses", "get_project", "list_teams", "list_cycles", "list_users", "list_issue_labels", "get_team"]
    }
  },
  "workflows": {
    "blog_creation": {
      "blog_directory": "app/content/blog",
      "image_directory": "public/images",
      "default_tags": ["tech", "troubleshooting"],
      "image_formats": ["png", "jpg", "jpeg", "webp"]
    }
  }
}
