{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yumenomatayume-net",
  "main": "./dist/index.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist"
  },
  // 送信先は検証済みの宛先アドレスに限定します（無料プランでもこの宛先への送信は無料）。
  // 実運用では app/routes/form.tsx の CONTACT_TO と下記 destination_address を、ご自身の Cloudflare アカウントで検証済みの同じアドレスに変更してください。
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "destination_address": "yumenomatayume@yumenomatayume.net"
    }
  ]
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // }
}